__pycache__/
*.pyc
# data: the MDF-lite feature cache (28 MB) is tracked; the datasets and raw MCAP recordings are too large for git
# (single files up to 908 MB; GitHub rejects files over 100 MB): see docs/HANDOFF.md section 12 for where they are
data/*
!data/mdf_cache/
# outputs: every MDF-lite run is tracked in full (config, training log, checkpoints ~20 MB each, demo figures,
# real-arm rollouts) plus the training / dashboard logs
outputs/*
!outputs/mdf/
*.mcap
*.mcap.part
wandb/
.env
*.egg-info/
